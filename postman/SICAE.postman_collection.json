              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Login exitoso\",\n  \"data\": {\n    \"idUsuario\": 7,\n    \"idRol\": 1,\n    \"rol\": \"administrador\",\n    \"usuario\": \"prueba\",\n    \"nombreCompleto\": \"Usuario Prueba\",\n    \"idTipoUsuario\": 1,\n    \"tipoUsuario\": \"Docente\",\n    \"token\": \"eyJhbGciOiJIUzI1NiJ9.eyJpZFJvbCI6MSwiaWRVc3VhcmlvIjo3LCJyb2wiOiJhZG1pbmlzdHJhZG9yIiwic3ViIjoicHJ1ZWJhIiwiaWF0IjoxNzgxMzI0Nzg5LCJleHAiOjE3ODE0MTExODl9.M-8Fs28quz2FxCN2QByQqV6LMypX33KJoTWCtWwSIi4\"\n  },\n  \"error\": null\n}"

      "name": "AuthService",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Esto lee el JSON que responde tu servicio",
                  "var jsonData = pm.response.json();",
                  "",
                  "// Si el login fue exitoso, guarda el token en la variable global",
                  "if(jsonData.success === true && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.data.token);",
                  "    console.log(\"Token guardado automáticamente: \" + jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"usuario\": \"prueba\",\n    \"contrasena\": \"prueba\"\n}"
            },
            "url": {
              "raw": "{{auth_base_url}}/auth/login",
              "host": [
                "{{auth_base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": [
            {
              "name": "Login Exitoso",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
